# Copiar a .env y completar. .env no se sube a git.
ODOO_URL=https://esmtcx.odoo.com
ODOO_DB=esmtcx
# Usuario de servicio: el worker de WhatsApp y el informe mensual leen Odoo con él
ODOO_USER=
ODOO_PASSWORD=

# Worker de WhatsApp (odoo_sync.py)
WHAI_URL=
WHAI_CLIENT_KEY=
WHAI_BOT_ID=
WHAI_GROUP_ID=

# IA: análisis de tickets y redacción del informe mensual
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Modelo de DeepSeek para el informe mensual (por defecto deepseek-v4-pro)
# IA_MODEL=

# Informe mensual: License Manager (licenciamiento de Genesys Cloud)
LM_API_URL=
LM_USER=
LM_PASSWORD=
# Correos o usuarios de Odoo que pueden generar informes, editar textos, el shortname y las integraciones
INFORMES_USUARIOS=

# Clave para firmar la cookie de sesión (si falta, se genera y se guarda en data/flask_secret.txt)
# FLASK_SECRET_KEY=
