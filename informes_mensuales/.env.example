# Copiar a .env y completar. .env no se sube a git.
# Odoo (piloto: copiadas de odoo_sync/.env; reemplazar por un usuario de servicio de solo lectura)
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# LicenseManager: URL de la API y un usuario con acceso a las organizaciones de los clientes
# (la organización de cada cliente se define en clientes.yaml)
LM_API_URL=
LM_USER=
LM_PASSWORD=

# Redacción con IA (opcional). Sin esto, la etapa "textos" deja un encargo para Claude Code.
# IA_PROVIDER=anthropic usa la API de Claude con ANTHROPIC_API_KEY (o un perfil de `ant auth login`).
# IA_PROVIDER=deepseek usa la API de DeepSeek con DEEPSEEK_API_KEY (la que usa odoo_sync).
IA_PROVIDER=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# IA_MODEL=claude-opus-5-5 (anthropic) o deepseek-v4-pro (deepseek)

# Carpeta de salida de los informes
SALIDA_DIR=./salida
